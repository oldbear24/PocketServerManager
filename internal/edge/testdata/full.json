                            "precompressed_order": [
                              "br",
                              "zstd",
                              "gzip"
                            ],
                            "root": "/srv/sites/blog/current",
                            "status_code": "{http.error.status_code}"
                          }
                        ],
                        "match": [
                          {
                            "expression": "{http.error.status_code} == 404"
                          }
                        ]
                      }
                    ]
                  }
